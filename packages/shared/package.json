{
  "name": "@repo/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
  "build": "tsc && npm run copy-assets",
  "copy-assets": "cpy \"src/**/*.ejs\" dist --parents",
  "dev": "tsc -w",
  "lint": "eslint . --max-warnings 0"
},
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "cpy-cli": "~7.0.0",
    "typescript": "^5.0.0"
  }
}
